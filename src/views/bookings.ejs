<%- include('partials/header') %>
<section class="bookings-admin">
    <h1><%= title %></h1>
    <p id="bookings-loading" class="trips-state" aria-live="polite">Loading bookings...</p>
    <p id="bookings-error" class="trips-state trips-error" hidden role="alert"></p>
    <p id="bookings-empty" class="trips-state" hidden>No bookings have been made.</p>
    <div class="bookings-table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Reference</th>
                    <th scope="col">Trip</th>
                    <th scope="col">Travel day</th>
                    <th scope="col">Ticket class</th>
                    <th scope="col">Passengers</th>
                    <th scope="col">Booked</th>
                </tr>
            </thead>
            <tbody id="bookings-list"></tbody>
        </table>
    </div>
</section>

<template id="booking-row-template">
    <tr>
        <td data-field="reference"></td>
        <td data-field="trip"></td>
        <td data-field="travel-day"></td>
        <td data-field="ticket"></td>
        <td data-field="passengers"></td>
        <td data-field="created"></td>
    </tr>
</template>
<%- include('partials/footer') %>
