<%- include('./partials/header') %>

<section class="bookings-hero">
    <h1>Bookings Admin</h1>
    <p>
        A live view of every booking made across the Kizuna Rail network.
    </p>
</section>

<section class="bookings-admin">
    <form class="bookings-filters" id="bookings-filters">
        <label>
            Ticket class
            <select name="ticketClass" id="filter-ticket-class">
                <option value="">All classes</option>
                <% ticketClasses.forEach((ticketClass) => { %>
                    <option value="<%= ticketClass %>"><%= ticketClass %></option>
                <% }); %>
            </select>
        </label>
        <label>
            Booked from
            <input type="date" name="startDate" id="filter-start-date">
        </label>
        <label>
            Booked to
            <input type="date" name="endDate" id="filter-end-date">
        </label>
        <button type="submit">Apply</button>
        <button type="button" id="filters-clear">Clear</button>
    </form>

    <div class="bookings-state" id="bookings-loading">Loading bookings...</div>
    <div class="bookings-state bookings-error" id="bookings-error" hidden></div>
    <div class="bookings-state bookings-empty" id="bookings-empty" hidden>No bookings have been made yet.</div>

    <table class="bookings-table" id="bookings-table" hidden>
        <thead>
            <tr>
                <th>Confirmation #</th>
                <th>Ticket Class</th>
                <th>Travel Day</th>
                <th>Passengers</th>
                <th>Booked On</th>
            </tr>
        </thead>
        <tbody id="bookings-list"></tbody>
    </table>

    <nav class="bookings-pagination" id="bookings-pagination" aria-label="Bookings pages" hidden>
        <button type="button" id="bookings-prev">Previous</button>
        <span id="bookings-page-info"></span>
        <button type="button" id="bookings-next">Next</button>
        <span id="bookings-range"></span>
    </nav>

    <template id="booking-row-template">
        <tr class="booking-row">
            <td data-field="id"></td>
            <td data-field="ticketClass"></td>
            <td data-field="selectedDay"></td>
            <td data-field="passengers"></td>
            <td data-field="createdAt"></td>
        </tr>
    </template>
</section>

<%- include('./partials/footer') %>
