<%- include('./partials/header') %>

    <section class="profile-page">

        <h1>My Profile</h1>

        <p id="profile-message" class="profile-message"></p>

        <form id="profile-form" data-user-id="<%= user._id || user.id %>">

            <div class="profile-field">
                <label for="display-name">
                    Display Name
                </label>

                <input type="text" id="display-name" name="displayName" value="<%= user.displayName %>" required>
            </div>

            <div class="profile-field">
                <label for="username">
                    Username
                </label>

                <input type="text" id="username" name="username" value="<%= user.username %>" readonly
                    aria-readonly="true">
            </div>

            <div class="profile-field">
                <label for="email">
                    Email
                </label>

                <input type="email" id="email" name="email" value="<%= user.email %>" required>
            </div>

            <div class="profile-field">
                <label for="password">
                    New Password
                </label>

                <input type="password" id="password" name="password" minlength="8"
                    placeholder="Leave blank to keep your current password">
            </div>

            <div class="profile-field">
                <label for="role">
                    Role
                </label>

                <input type="text" id="role" value="<%= user.role === '2' ? 'Admin' : 'Customer' %>" readonly
                    aria-readonly="true">
            </div>

            <button type="submit" class="btn">
                Save Changes
            </button>

        </form>

    </section>

    <script type="module" src="/js/profile.js"></script>

    <%- include('./partials/footer') %>