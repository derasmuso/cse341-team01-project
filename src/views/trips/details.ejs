```ejs
<%- include('../partials/header') %>

<article class="route-detail">

    <div class="route-header">

        <div class="route-header-content">

            <h1 class="route-name"><%= details.name %></h1>

            <p class="route-description"><%= details.description %></p>

            <% if (details.highlights && details.highlights.length > 0) { %>
            <div class="highlights">

                <% details.highlights.forEach(function(highlight) { %>

                <span class="highlight-tag"><%= highlight %></span>

                <% }); %>

            </div>
            <% } %>

        </div>

        <% if (details.imageUrl) { %>

        <div class="route-image">

            <img src="<%= details.imageUrl %>" alt="<%= details.name %>">

        </div>

        <% } %>

    </div>

    <div class="route-info">

        <div class="info-grid">

            <div class="info-item">

                <span class="info-label">Region</span>

                <span class="info-value region-<%= details.region %>">

                    <%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %>

                </span>

            </div>

            <div class="info-item">

                <span class="info-label">Duration</span>

                <span class="info-value"><%= details.duration %></span>

            </div>

            <div class="info-item">

                <span class="info-label">Distance</span>

                <span class="info-value"><%= details.distance %> km</span>

            </div>

            <div class="info-item">

                <span class="info-label">Best Season</span>

                <span class="info-value season-<%= details.bestSeason %>">

                    <%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %>

                </span>

            </div>

        </div>

        <div class="route-stations">

            <h2>Trip</h2>

            <div class="stations">

                <div class="station">

                    <span class="station-label">Start</span>

                    <span class="station-name">

                        <%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %>

                    </span>

                </div>

                <div class="station">

                    <span class="station-label">End</span>

                    <span class="station-name">

                        <%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %>

                    </span>

                </div>

            </div>

        </div>

        <div class="route-operating">

            <h2>Operating Schedule</h2>

            <div class="months-grid">

                <%
                const monthNames = [
                    "January",
                    "February",
                    "March",
                    "April",
                    "May",
                    "June",
                    "July",
                    "August",
                    "September",
                    "October",
                    "November",
                    "December"
                ];
                %>

                <% details.operatingMonths.forEach(function(month) { %>

                <button
                    type="button"
                    class="month-badge"
                    data-month="<%= month %>"
                >
                    <%= monthNames[month - 1] %>
                </button>

                <% }); %>

            </div>

        </div>

        <div class="route-schedules">

            <h2>Available Schedules</h2>

            <div id="schedules-container" class="schedules-grid">

                <p>Loading schedules...</p>

            </div>

        </div>

    </div>

</article>

<script>

    const tripId = "<%= details.id %>";

    const schedulesContainer = document.getElementById("schedules-container");

    const monthButtons = document.querySelectorAll(".month-badge");


    async function loadSchedules(month = null) {

        try {

            schedulesContainer.innerHTML = "<p>Loading schedules...</p>";

            let url = `/api/trips/${tripId}/schedules`;

            if (month) {

                url += `?month=${month}`;

            }

            const response = await fetch(url);

            if (!response.ok) {

                throw new Error("Failed to fetch schedules");

            }

            const schedules = await response.json();

            if (schedules.length === 0) {

                schedulesContainer.innerHTML =
                    "<p>No schedules available for this month.</p>";

                return;

            }

            schedulesContainer.innerHTML = "";

            schedules.forEach(function(schedule) {

                const scheduleCard = document.createElement("div");

                scheduleCard.className = "schedule-card";


                const scheduleTimes = document.createElement("div");

                scheduleTimes.className = "schedule-times";


                scheduleTimes.innerHTML = `

                    <div class="time-block">

                        <span class="time-label">Departs</span>

                        <span class="time-value">${schedule.departureTime}</span>

                    </div>

                    <span class="time-arrow">→</span>

                    <div class="time-block">

                        <span class="time-label">Arrives</span>

                        <span class="time-value">${schedule.arrivalTime}</span>

                    </div>

                `;


                const scheduleDays = document.createElement("div");

                scheduleDays.className = "schedule-days";


                schedule.daysOfWeek.forEach(function(day) {

                    const dayBadge = document.createElement("span");

                    dayBadge.className = "day-badge";

                    dayBadge.textContent = day.substring(0, 3);

                    scheduleDays.appendChild(dayBadge);

                });


                const bookButton = document.createElement("a");

                bookButton.href = `/trips/booking/${schedule.id}`;

                bookButton.className = "book-btn";

                bookButton.textContent = "Book Now";


                scheduleCard.appendChild(scheduleTimes);

                scheduleCard.appendChild(scheduleDays);

                scheduleCard.appendChild(bookButton);

                schedulesContainer.appendChild(scheduleCard);

            });

        } catch (error) {

            console.error("Error loading schedules:", error);

            schedulesContainer.innerHTML =
                "<p>Unable to load schedules. Please try again.</p>";

        }

    }


    monthButtons.forEach(function(button) {

        button.addEventListener("click", function() {

            const month = button.dataset.month;

            loadSchedules(month);

        });

    });


    loadSchedules();

</script>

<%- include('../partials/footer') %>

