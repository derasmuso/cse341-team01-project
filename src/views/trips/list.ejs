<%- include('../partials/header') %>
    <h1>
        <%= title %>
    </h1>

    <div id="filters">
        Search by Region:
        <select id="region-filter">
            <option value="all">All Regions</option>
            <% regions.forEach((region)=> { %>
                <option value="<%= region %>">
                    <%= region.charAt(0).toUpperCase() + region.slice(1) %>
                </option>
                <% }); %>
        </select>

        Search by Season:
        <select id="season-filter">
            <option value="all">Any Season</option>
            <% seasons.forEach((season)=> { %>
                <option value="<%= season %>">
                    <%= season.charAt(0).toUpperCase() + season.slice(1) %>
                </option>
                <% }); %>
        </select>
        <form id="trip-search-form" role="search">
            <label for="search-filter">Search:</label>
            <input type="search" id="search-filter" placeholder="Name or description">
            <button type="submit">Search</button>
        </form>
    </div>

    <div class="trips-state" id="trips-loading">Loading trips...</div>
    <div class="trips-state trips-error" id="trips-error" hidden></div>
    <div class="trips-state" id="trips-empty" hidden>No trips match your filters.</div>

    <div class="routes-grid" id="trips-list"></div>

    <nav class="trips-pagination" id="trips-pagination" aria-label="Trip pages" hidden>
        <button type="button" id="trips-prev">&larr; Previous</button>
        <span id="trips-page-indicator"></span>
        <button type="button" id="trips-next">Next &rarr;</button>
    </nav>

    <template id="trip-card-template">
        <div class="route-card">
            <div class="route-header">
                <h2 class="route-name" data-field="name"></h2>
                <span class="route-region" data-field="region"></span>
            </div>

            <div class="station-info">
                <div class="station">
                    <div class="station-type">From:</div>
                    <div class="station-name" data-field="start"></div>
                </div>
                <div class="route-arrow">&#8594;</div>
                <div class="station">
                    <div class="station-type">To:</div>
                    <div class="station-name" data-field="end"></div>
                </div>
            </div>

            <div class="route-details">
                <div class="detail-item">
                    <span class="detail-icon">&#128337;</span>
                    <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
                </div>
                <div class="detail-item">
                    <span class="detail-icon">&#128205;</span>
                    <span><span class="detail-label">Distance:</span> <span data-field="distance"></span></span>
                </div>
                <div class="detail-item">
                    <span class="season-badge" data-field="season"></span>
                </div>
            </div>

            <div class="route-description" data-field="description"></div>

            <div class="highlights">
                <div class="highlights-list" data-field="highlights"></div>
            </div>

            <div class="route-actions">
                <a href="#" class="view-details-btn" data-field="link">
                    View Details &amp; Book &#8594;
                </a>
            </div>
        </div>
    </template>

    <%- include('../partials/footer') %>