<main class="admin-users-page">
    <h2>Manage Users</h2><hr><br>

    <p id="users-message" role="status" aria-live="polite"></p>

    <!-- User filters -->
    <div class="users-filters">
        <div>
            <label for="users-search">Search users</label>
            <input type="search" id="users-search" placeholder="Search name, username, or email" maxlength="100">
        </div>
    
        <div>
            <label for="users-role-filter">Filter by role</label>
            <select id="users-role-filter">
                <option value="">All roles</option>
                <option value="1">Customer</option>
                <option value="2">Admin</option>
            </select>
        </div>
    
        <button type="button" id="users-clear-filters">
            Clear filters
        </button>
    </div>

    <!-- User list container -->
    <div id="users-container">
        <p>Loading users...</p>
    </div>

    <nav id="users-pagination" class="users-pagination" aria-label="User list pagination" hidden>
        <button type="button" id="users-previous-page" disabled>
            Previous
        </button>

        <span id="users-page-info">Page 1 of 1</span>

        <button type="button" id="users-next-page" disabled>
            Next
        </button>
    </nav>
</main>

<!-- Edit user modal -->
<dialog id="edit-user-modal" aria-labelledby="edit-user-title">
    <div class="edit-user-modal-content">
        <h2 id="edit-user-title">Edit User</h2>

        <form id="user-edit-form">
            <input type="hidden" name="userId">

            <label>
                Display Name
                <input type="text" name="displayName" required>
            </label>

            <label>
                Username
                <input type="text" name="username" readonly aria-readonly="true">
            </label>

            <label>
                Email
                <input type="email" name="email" required>
            </label>

            <label>
                New Password
                <input type="password" name="password" minlength="8" autocomplete="new-password"
                    placeholder="Leave blank to keep current password">
                <small>
                    Leave blank to keep the current password.
                    Enter at least 8 characters to change it.
                </small>
            </label>

            <label>
                Role
                <select name="role" required>
                    <option value="1">Customer</option>
                    <option value="2">Admin</option>
                </select>
            </label>

            <p id="edit-user-message" role="alert" aria-live="assertive"></p>

            <div class="user-actions">
                <button type="submit" id="save-user-button">
                    Save
                </button>

                <button type="button" id="cancel-edit-button">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</dialog>

<script type="module" src="/js/admin-users.js"></script>

