<%- include('../partials/header') %>

<main class="admin-trips-page">


<h1>Trip Management</h1>

<p>Manage all Kizuna Rail trips.</p>

<div id="trip-message"></div>

<section id="trips-list">
    <p>Loading trips...</p>
</section>
```

</main>

<script type="application/json" id="stations-data"><%- JSON.stringify(stations) %></script>

<script type="application/json" id="schedules-data"><%- JSON.stringify(schedules) %></script>

<script type="application/json" id="schedules-by-trip-data"><%- JSON.stringify(schedulesByTrip) %></script>

<script>

    const tripsList = document.getElementById('trips-list');
    const message = document.getElementById('trip-message');

    const stations = JSON.parse(
        document.getElementById('stations-data').textContent
    );

    const schedules = JSON.parse(
        document.getElementById('schedules-data').textContent
    );

    const schedulesByTrip = JSON.parse(
        document.getElementById('schedules-by-trip-data').textContent
    );


    async function loadTrips() {

        try {

            const response = await fetch('/api/trips');

            if (!response.ok) {
                throw new Error('Failed to load trips');
            }

            const trips = await response.json();

            if (trips.length === 0) {

                tripsList.innerHTML = '<p>No trips found.</p>';

                return;
            }


            tripsList.innerHTML = trips.map((trip) => `

                <article
                    class="trip-card"
                    id="trip-${escapeHtml(trip.id)}"
                >

                    <div class="trip-view">

                        <h2>${escapeHtml(trip.name)}</h2>

                        <p>
                            ${escapeHtml(trip.description)}
                        </p>

                        <p>
                            <strong>Route:</strong>

                            ${escapeHtml(
                                getStationName(trip.startStation)
                            )}

                            →

                            ${escapeHtml(
                                getStationName(trip.endStation)
                            )}
                        </p>

                        <p>
                            <strong>Region:</strong>
                            ${escapeHtml(trip.region)}
                        </p>

                        <p>
                            <strong>Duration:</strong>
                            ${escapeHtml(trip.duration)}
                        </p>

                        <p>
                            <strong>Distance:</strong>
                            ${trip.distance} km
                        </p>

                        <div>

                            <button
                                type="button"
                                onclick="showEditForm('${escapeHtml(trip.id)}')"
                            >
                                Edit
                            </button>

                            <button
                                type="button"
                                onclick="deleteTrip('${escapeHtml(trip.id)}')"
                            >
                                Delete
                            </button>

                        </div>

                    </div>


                    <form
                        class="trip-edit-form"
                        id="edit-form-${escapeHtml(trip.id)}"
                        style="display: none;"
                        onsubmit="saveTrip(event, '${escapeHtml(trip.id)}')"
                    >

                        <h3>Edit Trip</h3>


                        <label for="name-${escapeHtml(trip.id)}">
                            Trip Name
                        </label>

                        <input
                            id="name-${escapeHtml(trip.id)}"
                            name="name"
                            type="text"
                            value="${escapeHtml(trip.name)}"
                            required
                        >


                        <label for="start-${escapeHtml(trip.id)}">
                            Start Station
                        </label>

                        <select
                            id="start-${escapeHtml(trip.id)}"
                            name="startStation"
                            required
                        >

                            ${stations.map((station) => `

                                <option
                                    value="${escapeHtml(station.id)}"
                                    ${
                                        station.id === trip.startStation
                                            ? 'selected'
                                            : ''
                                    }
                                >
                                    ${escapeHtml(station.name)}
                                </option>

                            `).join('')}

                        </select>


                        <label for="end-${escapeHtml(trip.id)}">
                            End Station
                        </label>

                        <select
                            id="end-${escapeHtml(trip.id)}"
                            name="endStation"
                            required
                        >

                            ${stations.map((station) => `

                                <option
                                    value="${escapeHtml(station.id)}"
                                    ${
                                        station.id === trip.endStation
                                            ? 'selected'
                                            : ''
                                    }
                                >
                                    ${escapeHtml(station.name)}
                                </option>

                            `).join('')}

                        </select>


                        <fieldset>

                            <legend>Schedules</legend>

                            ${schedules.map((schedule) => {

                                const tripSchedules =
                                    schedulesByTrip[trip.id] || [];

                                const isSelected =
                                    tripSchedules.some(
                                        (tripSchedule) =>
                                            tripSchedule.id === schedule.id
                                    );

                                return `

                                    <label>

                                        <input
                                            type="checkbox"
                                            name="scheduleIds"
                                            value="${escapeHtml(schedule.id)}"
                                            ${
                                                isSelected
                                                    ? 'checked'
                                                    : ''
                                            }
                                        >

                                        ${escapeHtml(
                                            schedule.departureTime
                                        )}

                                        →

                                        ${escapeHtml(
                                            schedule.arrivalTime
                                        )}

                                        (${escapeHtml(
                                            schedule.daysOfWeek.join(', ')
                                        )})

                                    </label>

                                `;

                            }).join('')}

                        </fieldset>


                        <div>

                            <button type="submit">
                                Save Changes
                            </button>

                            <button
                                type="button"
                                onclick="cancelEdit('${escapeHtml(trip.id)}')"
                            >
                                Cancel
                            </button>

                        </div>

                    </form>

                </article>

            `).join('');


        } catch (error) {

            tripsList.innerHTML =
                '<p>Unable to load trips.</p>';

            console.error(error);

        }

    }


    function getStationName(stationId) {

        const station = stations.find(
            (item) => item.id === stationId
        );

        return station ? station.name : stationId;

    }


    function showEditForm(id) {

        const card = document.getElementById(`trip-${id}`);

        const view = card.querySelector('.trip-view');

        const form = card.querySelector('.trip-edit-form');

        view.style.display = 'none';

        form.style.display = 'block';

    }


    function cancelEdit(id) {

        const card = document.getElementById(`trip-${id}`);

        const view = card.querySelector('.trip-view');

        const form = card.querySelector('.trip-edit-form');

        form.style.display = 'none';

        view.style.display = 'block';

    }


    async function saveTrip(event, id) {

        event.preventDefault();

        const form = event.target;

        const name =
            form.elements.name.value;

        const startStation =
            form.elements.startStation.value;

        const endStation =
            form.elements.endStation.value;


        const scheduleIds = Array.from(
            form.querySelectorAll(
                'input[name="scheduleIds"]:checked'
            )
        ).map(
            (input) => input.value
        );


        try {

            const response = await fetch(
                `/api/trips/${id}`,
                {
                    method: 'PUT',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        name,
                        startStation,
                        endStation,
                        scheduleIds
                    })
                }
            );


            const result = await response.json();


            if (!response.ok) {

                throw new Error(
                    result.error ||
                    'Failed to update trip'
                );

            }


            message.innerHTML =
                '<p>Trip updated successfully.</p>';


            await loadTrips();


        } catch (error) {

            message.innerHTML =
                `<p>${escapeHtml(error.message)}</p>`;

        }

    }


    async function deleteTrip(id) {

        const confirmed = confirm(
            'Are you sure you want to delete this trip?'
        );


        if (!confirmed) {
            return;
        }


        try {

            const response = await fetch(
                `/api/trips/${id}`,
                {
                    method: 'DELETE'
                }
            );


            const result = await response.json();


            if (!response.ok) {

                throw new Error(
                    result.error ||
                    'Failed to delete trip'
                );

            }


            message.innerHTML =
                '<p>Trip deleted successfully.</p>';


            await loadTrips();


        } catch (error) {

            message.innerHTML =
                `<p>${escapeHtml(error.message)}</p>`;

        }

    }


    function escapeHtml(value) {

        const div =
            document.createElement('div');

        div.textContent =
            value ?? '';

        return div.innerHTML;

    }


    loadTrips();

</script>

<%- include('../partials/footer') %>
