<%- include('../partials/header') %>

    <div class="dashboard-layout">

        <aside class="dashboard-sidebar">
            <div class="dashboard-sidebar-header">
                <h2>Kizuna Railway</h2>
            </div>

            <nav class="dashboard-nav">
                <a class="dashboard-nav-link active" href="/admin/dashboard">
                    Admin Dashboard
                </a>

                <a class="dashboard-nav-link" href="/admin/users">
                    Users Management
                </a>

                <a class="dashboard-nav-link" href="/admin/bookings">
                    Bookings Admin
                </a>

                <a class="dashboard-nav-link" href="/profile">
                    My Profile
                </a>
            </nav>
        </aside>

        <main class="dashboard-main">

            <section class="dashboard-hero">
                <h1>Welcome, <%= user.displayName %></h1>
                <p>Your trips, plus every booking across the network.</p>
            </section>

            <section class="dashboard-bookings">
                <h2>My bookings</h2>

                <div class="dashboard-state" id="my-bookings-loading">Loading your bookings...</div>
                <div class="dashboard-state dashboard-error" id="my-bookings-error" hidden></div>
                <div class="dashboard-state" id="my-bookings-empty" hidden>
                    You are not a passenger on any bookings yet.
                </div>

                <table class="dashboard-table" id="my-bookings-table" hidden>
                    <thead>
                        <tr>
                            <th>Confirmation #</th>
                            <th>Ticket Class</th>
                            <th>Travel Day</th>
                            <th>Passengers</th>
                            <th>Booked On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="my-bookings-list"></tbody>
                </table>

                <template id="my-booking-row-template">
                    <tr>
                        <td data-field="id"></td>
                        <td data-field="ticketClass"></td>
                        <td data-field="selectedDay"></td>
                        <td data-field="passengers"></td>
                        <td data-field="createdAt"></td>
                        <td>
                            <button type="button" class="booking-delete" data-field="delete">Delete</button>
                        </td>
                    </tr>
                </template>
            </section>

            <section class="dashboard-bookings">
                <h2>All bookings</h2>

                <div class="dashboard-state" id="bookings-loading">Loading bookings...</div>
                <div class="dashboard-state dashboard-error" id="bookings-error" hidden></div>
                <div class="dashboard-state" id="bookings-empty" hidden>
                    No bookings have been made yet.
                </div>

                <table class="dashboard-table" id="bookings-table" hidden>
                    <thead>
                        <tr>
                            <th>Confirmation #</th>
                            <th>Ticket Class</th>
                            <th>Travel Day</th>
                            <th>Passengers</th>
                            <th>Booked On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bookings-list"></tbody>
                </table>

                <nav class="bookings-pagination" id="bookings-pagination" aria-label="Bookings pages" hidden>
                    <button type="button" id="bookings-prev">Previous</button>
                    <span id="bookings-page-info"></span>
                    <button type="button" id="bookings-next">Next</button>
                    <span id="bookings-range"></span>
                </nav>

                <template id="booking-row-template">
                    <tr>
                        <td data-field="id"></td>
                        <td data-field="ticketClass"></td>
                        <td data-field="selectedDay"></td>
                        <td data-field="passengers"></td>
                        <td data-field="createdAt"></td>
                        <td>
                            <button type="button" class="booking-delete" data-field="delete">Delete</button>
                        </td>
                    </tr>
                </template>
            </section>

        </main>

    </div>

    <%- include('../partials/footer') %>