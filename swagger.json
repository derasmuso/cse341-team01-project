{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "API for Kizuna Rail scenic train trips"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/api/bookings": {
      "get": {
        "summary": "Get all bookings",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "A list of all bookings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bookings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error while fetching bookings."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Passenger": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Yuki"
          },
          "lastName": {
            "type": "string",
            "example": "Tanaka"
          },
          "email": {
            "type": "string",
            "example": "yuki.tanaka@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+81 90-1234-5678"
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique booking confirmation code.",
            "example": "JR4F9X2A1B"
          },
          "scheduleId": {
            "type": "string",
            "example": "12"
          },
          "tripId": {
            "type": "string",
            "example": "3"
          },
          "ticketClass": {
            "type": "string",
            "example": "standard"
          },
          "selectedDay": {
            "type": "string",
            "example": "Monday"
          },
          "passengers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Passenger"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": []
}